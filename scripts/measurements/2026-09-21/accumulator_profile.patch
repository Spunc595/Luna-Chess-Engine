+// INSTRUMENTATION (scratch build, never committed): time spent in the accumulator functions, by rdtsc.
+pub mod prof {
+    use std::cell::UnsafeCell;
+    pub const ADD: usize = 0; pub const REM: usize = 1; pub const REFRESH1: usize = 2; pub const EVAL: usize = 3;
+    pub const MAKE_PROP: usize = 4; pub const KING_MAKE: usize = 5; pub const DISCARD: usize = 15;
+    thread_local! { pub static T: UnsafeCell<[u64; 32]> = UnsafeCell::new([0; 32]); }
+    // per context (0 make, 1 unmake, 2 other): [ctx][id] ticks and calls; [ctx][16 + id]
+    thread_local! { pub static U: UnsafeCell<[u64; 96]> = UnsafeCell::new([0; 96]); }
+    thread_local! { pub static CTX: std::cell::Cell<usize> = std::cell::Cell::new(2); }
+    thread_local! { pub static WT: UnsafeCell<[u64; 8]> = UnsafeCell::new([0; 8]); }   // 0/1 make ticks/calls, 2/3 unmake ticks/calls
+    thread_local! { pub static TRACE: UnsafeCell<Vec<u32>> = UnsafeCell::new(Vec::new()); }
+    #[inline(always)] pub fn set_ctx(c: usize) -> usize { CTX.with(|x| x.replace(c)) }
+    #[inline(always)] pub fn wt(i: usize, ticks: u64) { WT.with(|t| unsafe { let a = &mut *t.get(); a[2*i] += ticks; a[2*i+1] += 1; }); }
+    pub fn get_u(ctx: usize, id: usize) -> (u64, u64) { U.with(|t| unsafe { let a = &*t.get(); (a[ctx*32 + id], a[ctx*32 + 16 + id]) }) }
+    pub fn get_wt(i: usize) -> (u64, u64) { WT.with(|t| unsafe { let a = &*t.get(); (a[2*i], a[2*i+1]) }) }
+    #[inline(always)] pub fn tsc() -> u64 { unsafe { core::arch::x86_64::_rdtsc() } }
+    // ticks in [id], calls in [16 + id]
+    #[inline(always)] pub fn add(id: usize, ticks: u64) { T.with(|t| unsafe { let a = &mut *t.get(); a[id] += ticks; a[16 + id] += 1; }); let c = CTX.with(|x| x.get()); U.with(|t| unsafe { let a = &mut *t.get(); a[c*32 + id] += ticks; a[c*32 + 16 + id] += 1; }); }
+    #[inline(always)] pub fn count(id: usize) { T.with(|t| unsafe { (&mut *t.get())[16 + id] += 1; }); }
+    pub fn get(id: usize) -> (u64, u64) { T.with(|t| unsafe { let a = &*t.get(); (a[id], a[16 + id]) }) }
+}
